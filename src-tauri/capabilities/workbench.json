{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workbench",
  "description": "Only the local formula workbench may access the app's result and settings commands.",
  "windows": ["workbench-*"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-start-dragging",
    "allow-initial-state", "allow-window-ready", "allow-begin-capture", "allow-cancel-session",
    "allow-retry-recognition", "allow-copy-result", "allow-open-settings", "allow-back-to-result",
    "allow-get-settings", "allow-save-settings", "allow-set-default-format", "allow-test-connection"
  ]
}
